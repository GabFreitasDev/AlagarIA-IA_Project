APP_NAME=Recife Flood API
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Opcional. Quando definido, a API usa Postgres como fonte principal.
# Exemplo local com Docker:
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/recife_gis
DATABASE_URL=

# Caminho do JSON exportado pelo notebook 08_logica_fuzzy.py.
# Usado apenas quando DATABASE_URL nao estiver definido.
# Pode ser absoluto ou relativo a pasta alagaria-api.
GOLD_RISK_JSON_PATH=data/risco_bairros_atual.json
